        <mxCell id="e13" value="触发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="gateway" source="record" target="close">
          <mxGeometry relative="1" as="geometry" />
