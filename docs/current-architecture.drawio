        <!-- 图例 -->
        <mxCell id="legend" value="蓝 = 用户客户端    黄 = earcon 网关（①每轮毫秒级 ②会话结束异步）    绿 = 持久层    灰 = 外部依赖" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
