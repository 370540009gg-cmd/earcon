        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="gateway" source="inject" target="record">
          <mxGeometry relative="1" as="geometry" />
