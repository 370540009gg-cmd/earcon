<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="当前完整架构">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════════ 顶部：用户侧 ═══════════ -->
        <mxCell id="zcode" value="ZCode / Codex 客户端&#xa;（ear代理JW provider → 127.0.0.1:8800）&#xa;正常工作：写代码、问答、调试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="desktop" value="earcon 桌面客户端&#xa;（pywebview 原生窗口）&#xa;看会话 / 看经验 / 审计删除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="40" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════ 中部：网关主体 ═══════════ -->
        <mxCell id="gateway" value="earcon 网关（127.0.0.1:8800，FastAPI）—— 学习代理，对客户端透明" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="980" height="300" as="geometry" />
        </mxCell>

        <!-- 请求路径（每一轮） -->
        <mxCell id="reqlabel" value="① 请求路径（每轮对话，毫秒级）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;fontStyle=2;" vertex="1" parent="gateway">
          <mxGeometry x="30" y="40" width="280" height="20" as="geometry" />
        </mxCell>

        <mxCell id="fingerprint" value="会话指纹&#xa;首条真实用户消息哈希&#xa;→ 同一会话归同一 sid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gateway">
          <mxGeometry x="30" y="70" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="route" value="模型路由（三层）&#xa;--route 显式 &gt; 客户端配置&#xa;&gt; 内置公有云表&#xa;（自过滤防回环）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gateway">
          <mxGeometry x="240" y="70" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="inject" value="经验注入&#xa;相似任务命中卡片&#xa;→ [earcon experience]&#xa;插入 system 上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gateway">
          <mxGeometry x="450" y="70" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="record" value="轨迹记录&#xa;每轮 (user, assistant)&#xa;落会话缓冲 + 持久化&#xa;标题动态更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gateway">
          <mxGeometry x="660" y="70" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- 学习路径 -->
        <mxCell id="learnlabel" value="② 学习路径（会话结束触发，后台异步）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;fontStyle=2;" vertex="1" parent="gateway">
          <mxGeometry x="30" y="160" width="300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="judge" value="裁判（DeepSeek-V4-Pro）&#xa;独立通道，一次配置全局生效&#xa;复盘整段轨迹 → 提炼 1~5 张卡片&#xa;「decision=中文决策 ; score=-3..+3」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gateway">
          <mxGeometry x="30" y="190" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="close" value="会话关闭判定&#xa;30 分钟无活动自动 / 手动 close&#xa;≥3 轮才提炼（单轮无价值）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gateway">
          <mxGeometry x="660" y="190" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="zcodename" value="ZCode 会话名匹配&#xa;opener ↔ tasks-index.sqlite&#xa;（searchable_text 开头匹配）&#xa;→ title =「自进化模型」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gateway">
          <mxGeometry x="360" y="190" width="270" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════ 底部：持久层 ═══════════ -->
        <mxCell id="sqlite" value="SQLite（earcon_memory.db，重启不丢）" style="swimlane;startSize=26;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cards" value="cards 表&#xa;经验卡片（task/title/action/G）&#xa;裁判提炼，正向/负向/待观察&#xa;可审计、可删除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sqlite">
          <mxGeometry x="20" y="40" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sesstable" value="sessions 表&#xa;进行中会话（sid/title/turns）&#xa;每轮落盘，网关重启恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sqlite">
          <mxGeometry x="260" y="40" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="zcodetasks" value="ZCode tasks-index.sqlite&#xa;（只读）会话名 ↔ 消息开头匹配" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="545" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="upstream" value="上游 LLM&#xa;（llm-gw.jd.local，权重冻结）&#xa;kimi-k3 / GLM-5.3 / DeepSeek&#xa;按 model 字段路由到真实上游" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="545" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- ═══════════ 连线 ═══════════ -->
        <mxCell id="e1" value="每轮请求&#xa;（带完整历史）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.15;entryY=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zcode" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="透明转发&#xa;（行为无变化）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gateway" target="upstream">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1120" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="UI API 拉取&#xa;（桥接，3 秒刷新）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.85;entryY=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="desktop" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="读写" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;entryX=0.5;entryY=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gateway" target="sqlite">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="只读匹配会话名" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.7;exitY=1;entryX=0.5;entryY=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gateway" target="zcodetasks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 网关内部箭头 -->
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="gateway" source="fingerprint" target="route">
          <mxGeometry relative="1" as="geometry" />
