        </mxCell>
        <mxCell id="6" value="1. Experience injection&#xa;new session's first request:&#xa;inject retrieved experience&#xa;cards into system context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="5">
          <mxGeometry x="60" y="185" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7" value="2. Transparent forward + record&#xa;requests pass through untouched;&#xa;responses stream back while turns&#xa;accumulate in the session buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="5">
          <mxGeometry x="330" y="185" width="230" height="80" as="geometry" />
        </mxCell>

