          <mxGeometry x="320" y="430" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="8" value="3. Judge (async)&#xa;credit assignment over the whole&#xa;trajectory: distill 1-5 cards&#xa;「decision=…; score −3..+3」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="5">
