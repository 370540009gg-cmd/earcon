        <mxCell id="3" value="Upstream LLM&#xa;(frozen weights, any OpenAI-&#xa;compatible endpoint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="225" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="5" value="earcon gateway — local proxy 127.0.0.1:8800 (clients stay unaware)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="680" height="500" as="geometry" />
